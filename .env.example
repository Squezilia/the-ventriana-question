# Ventriana Sorunu (The Ventrian Question): environment template
# Copy to `.env` and fill in the values. NEVER commit `.env` to git.

# --- Model (required for real runs) ---
# API key from Google AI Studio
GEMINI_API_KEY=
# Exact API model id (copy it from AI Studio, "Get code")
MODEL_ID=

# --- Rate limits (required for real runs) ---
# Take these from the model's free-tier limits in AI Studio, and set them a bit lower
RPM_LIMIT=
TPM_LIMIT=
# Parallel LLM calls; lower to 2 if RPM_LIMIT is small
MAX_CONCURRENCY=4

# --- Budget guards (empty = no limit) ---
# Hard cap on LLM calls for the whole run (about 6000 for 56 days)
MAX_TOTAL_CALLS=
# Cap per calendar day, set below the free-tier daily request limit
DAILY_CALL_BUDGET=

# --- Simulation ---
# Master RNG seed; change it to get a different run
SIM_SEED=42
# Language of prompts and agent speech: tr or en
SIM_LANGUAGE=en
# Run length in days: 3 for the pilot, 14 for the first cycle, 56 for a full run
SIM_DAYS=3

# --- Output and UI ---
OUTPUT_DIR=./runs
UI_PORT=8787
# true during the pilot so the full prompts can be reviewed; false for full runs (files get large)
LOG_FULL_PROMPTS=true
# true = no API calls, random valid actions (for tests and dry runs)
MOCK_LLM=false
